{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "eg2-rag",
  "version": "0.1.0",
  "identifier": "com.eg2rag.app",
  "build": {
    "frontendDist": "../src-ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "eg2-rag",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
